# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Stripe ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=            # Stripe secret key (sk_test_... for test, sk_live_... for production)
STRIPE_WEBHOOK_SECRET=        # Stripe webhook endpoint secret (whsec_...)
STRIPE_PRICE_ID_STARTER=              # Monthly Starter plan (price_...)
STRIPE_PRICE_ID_STARTER_ANNUAL=       # Annual Starter plan (price_...)
STRIPE_PRICE_ID_PRO=                  # Monthly Pro plan (price_...)
STRIPE_PRICE_ID_PRO_ANNUAL=           # Annual Pro plan (price_...)
STRIPE_PRICE_ID_ENTERPRISE=           # Monthly Enterprise plan (price_...)
STRIPE_PRICE_ID_ENTERPRISE_ANNUAL=    # Annual Enterprise plan (price_...)
STRIPE_PRICE_ID_CREDITS_SMALL=        # One-time: 50 credits for $9 (price_...)
STRIPE_PRICE_ID_CREDITS_MEDIUM=       # One-time: 200 credits for $29 (price_...)

# ── Email (SMTP) ────────────────────────────────────────────────
SMTP_HOST=                    # smtp.resend.com or smtp.gmail.com
SMTP_PORT=587                 # 587 for TLS, 465 for SSL
SMTP_USER=                    # SMTP username
SMTP_PASS=                    # SMTP password or API key
SMTP_FROM=                    # LeadIntel AI <noreply@yourdomain.com>
APP_URL=                      # https://yourdomain.com

# ── Google AdSense ──────────────────────────────────────────────
VITE_ADSENSE_PUBLISHER_ID=    # ca-pub-XXXXXXXXXXXXXXXX (optional, omit to disable ads)
